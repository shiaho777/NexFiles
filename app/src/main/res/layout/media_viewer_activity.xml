<!--
  Media viewer backed by Media3 ExoPlayer. PlayerView provides transport controls, a scrubber,
  and resize toggles out of the box, so we no longer need the stock MediaController wiring the
  VideoView version had. Audio-only files play with the same controls and a blank surface.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:use_controller="true"
        app:show_buffering="when_playing"
        app:controller_hide_on_touch="true"
        app:auto_show="true" />
</FrameLayout>
